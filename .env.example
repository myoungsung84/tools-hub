# ─── Vercel / Site ───────────────────────────────────────────────────────────
# 배포 URL. 설정하지 않으면 VERCEL_URL(자동) → localhost:3000 순으로 폴백됩니다.
NEXT_PUBLIC_SITE_URL=https://tools.example.com

# ─── 공공데이터포털 ──────────────────────────────────────────────────────────
# 달력/공휴일 API (apis.data.go.kr) 에 필요합니다.
DATA_GO_KR_SERVICE_KEY=your_data_go_kr_service_key_here

# ─── IP 조회 ─────────────────────────────────────────────────────────────────
# ipwho.is 기반. API Key 불필요 — 서버 API(/api/ip)에서만 호출합니다.

# ─── 지도 ────────────────────────────────────────────────────────────────────
# OpenStreetMap embed iframe 사용. API Key 불필요합니다.
